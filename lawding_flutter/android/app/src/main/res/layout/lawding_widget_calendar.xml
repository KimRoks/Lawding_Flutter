<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:paddingStart="11dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp"
    android:gravity="center_vertical">

    <!-- 왼쪽 컬럼: CSS 110dp 고정 -->
    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/widget_cal_left_label"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="예정 연차"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/widget_cal_left_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="--"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700" />

        <TextView
            android:id="@+id/widget_cal_left_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="--"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="600" />

        <TextView
            android:id="@+id/widget_cal_left_dday"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="14dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="--"
            android:textColor="@color/widget_accent"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:gravity="center"
            android:background="@drawable/widget_pill_background" />

    </LinearLayout>

    <!-- 구분선: 12dp gap → 1dp → 14dp gap -->
    <TextView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/widget_divider" />

    <!-- 오른쪽 컬럼: CSS 110dp 고정 -->
    <LinearLayout
        android:layout_width="110dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/widget_cal_right_label"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="이후 예정 연차"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/widget_cal_right_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="--"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700" />

        <TextView
            android:id="@+id/widget_cal_right_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="--"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="600" />

        <TextView
            android:id="@+id/widget_cal_right_dday"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="14dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="--"
            android:textColor="@color/widget_text_secondary"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:gravity="center"
            android:background="@drawable/widget_pill_gray_background" />

    </LinearLayout>

    <!-- 버튼: 나머지 공간 전부 (~107dp), 아이콘 중앙 정렬 -->
    <LinearLayout
        android:id="@+id/btn_add_calendar"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_calendar_add"
            android:contentDescription="연차 추가" />

    </LinearLayout>

</LinearLayout>
