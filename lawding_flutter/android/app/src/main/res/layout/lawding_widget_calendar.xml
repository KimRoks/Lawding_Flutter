<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:gravity="center_vertical">

    <!-- 왼쪽: 예정 연차 (컨텐츠 크기만큼만 차지) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/widget_cal_left_label"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="예정 연차"
            android:textColor="#111111"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/widget_cal_left_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="--"
            android:textColor="#111111"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_bold" />

        <TextView
            android:id="@+id/widget_cal_left_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="--"
            android:textColor="#555555"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_semibold" />

        <TextView
            android:id="@+id/widget_cal_left_dday"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="--"
            android:textColor="#0057B8"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:background="@drawable/widget_pill_background" />

    </LinearLayout>

    <!-- 구분선 -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="#E1E1E1"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <!-- 이후 예정 연차 (컨텐츠 크기만큼만 차지) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/widget_cal_right_label"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="이후 예정 연차"
            android:textColor="#111111"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center_vertical" />

        <TextView
            android:id="@+id/widget_cal_right_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="--"
            android:textColor="#111111"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_bold" />

        <TextView
            android:id="@+id/widget_cal_right_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="--"
            android:textColor="#555555"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_semibold" />

        <TextView
            android:id="@+id/widget_cal_right_dday"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="--"
            android:textColor="#555555"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_bold"
            android:gravity="center"
            android:background="@drawable/widget_pill_gray_background" />

    </LinearLayout>

    <!-- flexible spacer: 남은 공간 흡수 -->
    <View
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <!-- 캘린더 추가 버튼 (고정 영역) -->
    <LinearLayout
        android:id="@+id/btn_add_calendar"
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_calendar_add"
            android:contentDescription="연차 추가" />

    </LinearLayout>

</LinearLayout>
