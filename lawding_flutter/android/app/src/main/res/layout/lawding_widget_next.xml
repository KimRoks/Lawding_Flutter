<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center_horizontal">

    <!-- 헤더: 아이콘 + 다음 연차 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="21dp"
            android:src="@drawable/calendar_tabbar"
            android:contentDescription="달력" />

        <TextView
            android:id="@+id/widget_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="다음 연차"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700" />

    </LinearLayout>

    <!-- Spacer 1 (SmallRemain의 첫 번째 spacer와 동일) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 날짜 -->
    <TextView
        android:id="@+id/widget_next_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="@color/widget_text_primary"
        android:textSize="28sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="700"
        android:gravity="center" />

    <!-- 연차 종류 -->
    <TextView
        android:id="@+id/widget_next_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="--"
        android:textColor="@color/widget_text_secondary"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="600"
        android:gravity="center" />

    <!-- Spacer 2 (SmallRemain의 두 번째 spacer와 동일) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- D-day pill -->
    <TextView
        android:id="@+id/widget_next_dday"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="--"
        android:textColor="@color/widget_accent"
        android:textSize="18sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="700"
        android:gravity="center"
        android:maxLines="1"
        android:background="@drawable/widget_pill_background" />

</LinearLayout>
