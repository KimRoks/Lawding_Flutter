<?xml version="1.0" encoding="utf-8"?>
<!-- 다가오는 일정이 없을 때: 리스트 없이 달력만 위젯을 채운다 (별도 디자인 측정값).
     세로 영역은 디자인 높이(dp)를 가중치로 나눠 위젯 높이가 달라도 같은 비율을 유지한다.
     주(row)는 cal_grid에 균등 분배되므로 4~6주 모두 하단 여백(21.5)이 유지된다. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="24.2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="24"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="40.6dp"
        android:paddingEnd="39.9dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="13dp"
            android:contentDescription="이전 달"
            android:src="@drawable/widget_cal_chevron_left" />

        <TextView
            android:id="@+id/cal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard_variable"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="--"
            android:textColor="@color/widget_text_primary"
            android:textFontWeight="700"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="13dp"
            android:contentDescription="다음 달"
            android:src="@drawable/widget_cal_chevron_right" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="18.8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="16"
        android:orientation="horizontal"
        android:paddingStart="32.3dp"
        android:paddingEnd="32.3dp">

        <TextView style="@style/WidgetCalWeekday" android:text="일" />
        <TextView style="@style/WidgetCalWeekday" android:text="월" />
        <TextView style="@style/WidgetCalWeekday" android:text="화" />
        <TextView style="@style/WidgetCalWeekday" android:text="수" />
        <TextView style="@style/WidgetCalWeekday" android:text="목" />
        <TextView style="@style/WidgetCalWeekday" android:text="금" />
        <TextView style="@style/WidgetCalWeekday" android:text="토" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2.1" />

    <LinearLayout
        android:id="@+id/cal_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="275.4"
        android:orientation="vertical"
        android:paddingStart="32.3dp"
        android:paddingEnd="32.3dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="21.5" />
</LinearLayout>
