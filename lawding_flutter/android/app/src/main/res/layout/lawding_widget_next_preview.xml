<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="23dp"
            android:src="@drawable/calendar_tabbar"
            android:contentDescription="달력" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="다음 연차"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="10월 15일"
        android:textColor="@color/widget_text_primary"
        android:textSize="30sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="700"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="연차"
        android:textColor="@color/widget_text_secondary"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="600"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="D-7"
        android:textColor="@color/widget_accent"
        android:textSize="20sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="700"
        android:gravity="center"
        android:maxLines="1"
        android:background="@drawable/widget_pill_background" />

</LinearLayout>
