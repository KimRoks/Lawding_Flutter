<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="예정 연차"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="10월 15일"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="연차"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="600" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="D-7"
            android:textColor="@color/widget_accent"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:gravity="center"
            android:background="@drawable/widget_pill_background" />

    </LinearLayout>

    <TextView
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/widget_divider"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="이후 예정 연차"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:gravity="center_vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="11월 3일"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="반차"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="600" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="D-25"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:gravity="center"
            android:background="@drawable/widget_pill_gray_background" />

    </LinearLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="52dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_calendar_add"
            android:contentDescription="연차 추가" />

    </LinearLayout>

</LinearLayout>
