<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- 달력 아이콘 + 다음 예정 연차 라벨 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="23dp"
            android:src="@drawable/calendar_tabbar"
            android:contentDescription="달력" />

        <TextView
            android:id="@+id/widget_medium_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="다음 예정 연차"
            android:textColor="#111111"
            android:textSize="15sp"
            android:fontFamily="@font/pretendard_bold" />
    </LinearLayout>

    <!-- 날짜 -->
    <TextView
        android:id="@+id/widget_medium_next_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="--월 --일"
        android:textColor="#111111"
        android:textSize="26sp"
        android:fontFamily="@font/pretendard_bold" />

    <!-- 연차 종류 -->
    <TextView
        android:id="@+id/widget_medium_next_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="--"
        android:textColor="#555555"
        android:textSize="13sp"
        android:fontFamily="@font/pretendard_semibold" />

    <!-- 구분선 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#E1E1E1" />

    <!-- 다음 일정 -->
    <TextView
        android:id="@+id/widget_medium_after_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="다음 일정 --"
        android:textColor="#555555"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_semibold" />

</LinearLayout>
