<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 달력 아이콘 + 잔여 연차 라벨 (중앙 정렬) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="16dp"
            android:layout_height="21dp"
            android:src="@drawable/calendar_tabbar"
            android:contentDescription="달력" />

        <TextView
            android:id="@+id/widget_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="잔여 연차"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700" />
    </LinearLayout>

    <!-- Spacer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 남은 일수 -->
    <TextView
        android:id="@+id/widget_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--일"
        android:textColor="@color/widget_text_primary"
        android:textSize="45sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="700"
        android:gravity="center" />

    <!-- Spacer -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 시간 pill -->
    <TextView
        android:id="@+id/widget_hours"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_pill_background"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center"
        android:text="--시간"
        android:textColor="@color/widget_accent"
        android:textSize="18sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="700" />

</LinearLayout>
