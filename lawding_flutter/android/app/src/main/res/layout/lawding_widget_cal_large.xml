<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <!-- 헤더: < 2026년 3월 > -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="14.5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="33dp"
        android:paddingEnd="34.5dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="13dp"
            android:contentDescription="이전 달"
            android:src="@drawable/widget_cal_chevron_left" />

        <TextView
            android:id="@+id/cal_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard_variable"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="--"
            android:textColor="@color/widget_text_primary"
            android:textFontWeight="700"
            android:textSize="17sp" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="13dp"
            android:contentDescription="다음 달"
            android:src="@drawable/widget_cal_chevron_right" />
    </LinearLayout>

    <!-- 요일 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="19.5dp"
        android:orientation="horizontal"
        android:paddingStart="25dp"
        android:paddingEnd="25dp">

        <TextView style="@style/WidgetCalWeekday" android:text="일" />
        <TextView style="@style/WidgetCalWeekday" android:text="월" />
        <TextView style="@style/WidgetCalWeekday" android:text="화" />
        <TextView style="@style/WidgetCalWeekday" android:text="수" />
        <TextView style="@style/WidgetCalWeekday" android:text="목" />
        <TextView style="@style/WidgetCalWeekday" android:text="금" />
        <TextView style="@style/WidgetCalWeekday" android:text="토" />
    </LinearLayout>

    <!-- 날짜 그리드: 주(row)를 프로바이더가 동적으로 추가 -->
    <LinearLayout
        android:id="@+id/cal_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingEnd="25dp" />

    <!-- 다가오는 일정 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="13.6dp"
        android:paddingEnd="15.4dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="0.9dp"
            android:background="@color/widget_divider" />

        <LinearLayout
            android:id="@+id/cal_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/cal_list_empty"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/pretendard_variable"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:paddingStart="20.4dp"
            android:text="다가오는 일정 없음"
            android:textColor="@color/widget_text_secondary"
            android:textFontWeight="600"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
