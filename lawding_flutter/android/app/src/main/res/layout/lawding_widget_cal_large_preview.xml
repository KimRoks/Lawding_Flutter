<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 갤러리 미리보기. 실제 위젯(lawding_widget_cal_large)과 같은 수치·색 토큰을 쓰는 정적 샘플. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="14.5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="33dp"
        android:paddingEnd="34.5dp">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="13dp"
            android:src="@drawable/widget_cal_chevron_left" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/pretendard_variable"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="2026년 3월"
            android:textColor="@color/widget_text_primary"
            android:textFontWeight="700"
            android:textSize="17sp" />

        <ImageView
            android:layout_width="8dp"
            android:layout_height="13dp"
            android:src="@drawable/widget_cal_chevron_right" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:layout_marginTop="19.5dp"
        android:orientation="horizontal"
        android:paddingStart="25dp"
        android:paddingEnd="25dp">

        <TextView style="@style/WidgetCalWeekday" android:text="일" />
        <TextView style="@style/WidgetCalWeekday" android:text="월" />
        <TextView style="@style/WidgetCalWeekday" android:text="화" />
        <TextView style="@style/WidgetCalWeekday" android:text="수" />
        <TextView style="@style/WidgetCalWeekday" android:text="목" />
        <TextView style="@style/WidgetCalWeekday" android:text="금" />
        <TextView style="@style/WidgetCalWeekday" android:text="토" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingEnd="25dp">

        <LinearLayout style="@style/WidgetCalPreviewRow">
            <FrameLayout style="@style/WidgetCalPreviewCell">
                <TextView style="@style/WidgetCalPreviewRedDay" android:text="1" />
                <ImageView style="@style/WidgetCalPreviewCellBar" android:src="@drawable/widget_cal_bar_holiday" />
                <TextView style="@style/WidgetCalPreviewLabel" android:text="삼일절" />
            </FrameLayout>
            <FrameLayout style="@style/WidgetCalPreviewCell">
                <TextView style="@style/WidgetCalPreviewRedDay" android:text="2" />
                <ImageView style="@style/WidgetCalPreviewCellBar" android:src="@drawable/widget_cal_bar_holiday" />
                <TextView style="@style/WidgetCalPreviewLabel" android:text="대체공휴일" />
            </FrameLayout>
            <FrameLayout style="@style/WidgetCalPreviewCell">
                <TextView style="@style/WidgetCalPreviewDay" android:text="3" />
                <ImageView style="@style/WidgetCalPreviewCellBar" android:src="@drawable/widget_cal_bar_leave" />
            </FrameLayout>
            <FrameLayout style="@style/WidgetCalPreviewCell">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/widget_cal_today" />
                <TextView
                    style="@style/WidgetCalPreviewDay"
                    android:text="4"
                    android:textColor="@android:color/white" />
            </FrameLayout>
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="5" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="6" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="7" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetCalPreviewRow">
            <TextView style="@style/WidgetCalPreviewPlainRedDay" android:text="8" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="9" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="10" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="11" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="12" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="13" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="14" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetCalPreviewRow">
            <TextView style="@style/WidgetCalPreviewPlainRedDay" android:text="15" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="16" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="17" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="18" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="19" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="20" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="21" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetCalPreviewRow">
            <TextView style="@style/WidgetCalPreviewPlainRedDay" android:text="22" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="23" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="24" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="25" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="26" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="27" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="28" />
        </LinearLayout>

        <LinearLayout style="@style/WidgetCalPreviewRow">
            <TextView style="@style/WidgetCalPreviewPlainRedDay" android:text="29" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="30" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="31" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="1" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="2" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="3" />
            <TextView style="@style/WidgetCalPreviewPlainDay" android:text="4" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="13.6dp"
        android:paddingEnd="15.4dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="7dp"
                android:layout_height="44dp"
                android:scaleType="fitXY"
                android:src="@drawable/widget_cal_list_bar_holiday" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13.4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/WidgetCalItemTitle" android:text="대체공휴일" />
                <TextView style="@style/WidgetCalItemSub" android:text="삼일절" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/WidgetCalDivider" android:layout_marginTop="2.5dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="7dp"
                android:layout_height="44dp"
                android:scaleType="fitXY"
                android:src="@drawable/widget_cal_list_bar_leave" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13.4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/WidgetCalItemTitle" android:text="치과 예약" />
                <TextView style="@style/WidgetCalItemSub" android:text="10:00 - 16:00" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8.7dp"
                android:background="@drawable/widget_pill_background"
                android:fontFamily="@font/pretendard_variable"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:singleLine="true"
                android:text="연차(8시간)"
                android:textColor="@color/widget_accent"
                android:textFontWeight="700"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
