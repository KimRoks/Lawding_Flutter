<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- 헤더: statistics_ic + 연차 종합현황 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="23dp"
            android:src="@drawable/ic_statistics"
            android:contentDescription="통계" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="연차 종합현황"
            android:textColor="#111111"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_bold" />
    </LinearLayout>

    <!-- 잔여 연차 (큰 숫자) -->
    <TextView
        android:id="@+id/widget_large_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="--일"
        android:textColor="#111111"
        android:textSize="55sp"
        android:fontFamily="@font/pretendard_bold" />

    <!-- 총 발생 연차 레이블 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="총 발생 연차"
        android:textColor="#999999"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_semibold" />

    <!-- 총 발생 연차 값 -->
    <TextView
        android:id="@+id/widget_large_total_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="--일"
        android:textColor="#999999"
        android:textSize="24sp"
        android:fontFamily="@font/pretendard_bold" />

    <!-- 연차 사용률 + 비율 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="연차 사용률"
            android:textColor="#0057B8"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_bold" />

        <TextView
            android:id="@+id/widget_large_usage_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#0057B8"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_bold" />
    </LinearLayout>

    <!-- 프로그레스 바 -->
    <ProgressBar
        android:id="@+id/widget_large_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_drawable" />

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="10dp" />

    <!-- 하단 정보 3줄 -->
    <TextView
        android:id="@+id/widget_large_period"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="사용 기간 : --"
        android:textColor="#999999"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_semibold" />

    <TextView
        android:id="@+id/widget_large_expiry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="다음 소멸 : --"
        android:textColor="#999999"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_semibold" />

    <TextView
        android:id="@+id/widget_large_next_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="다음 연차 : --"
        android:textColor="#999999"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_semibold" />

</LinearLayout>
