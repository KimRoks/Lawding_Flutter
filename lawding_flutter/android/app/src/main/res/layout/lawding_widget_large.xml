<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="33dp"
    android:paddingEnd="31dp"
    android:paddingTop="32dp"
    android:paddingBottom="38dp">

    <!-- 그룹1: 헤더 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="23dp"
            android:src="@drawable/ic_statistics"
            android:contentDescription="통계" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="연차 종합현황"
            android:textColor="@color/widget_text_primary"
            android:textSize="18sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- 그룹2: 큰 숫자 -->
    <TextView
        android:id="@+id/widget_large_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="--일"
        android:textColor="@color/widget_text_primary"
        android:textSize="55sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="700"
        android:includeFontPadding="false" />

    <!-- 그룹3: 총 발생 연차 (레이블 + 값) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="총 발생 연차"
        android:textColor="@color/widget_text_muted"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="500"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_large_total_days"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="--일"
        android:textColor="@color/widget_text_muted"
        android:textSize="24sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="700"
        android:includeFontPadding="false" />

    <!-- 그룹4: 연차 사용률 (레이블 + 그래프) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="연차 사용률"
            android:textColor="@color/widget_accent"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_large_usage_rate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@color/widget_accent"
            android:textSize="14sp"
            android:fontFamily="@font/pretendard_variable"
            android:textFontWeight="700"
            android:includeFontPadding="false" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_large_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/widget_progress_drawable" />

    <!-- 스트레치 존: 화면 크기에 따라 여기만 늘어남 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="40dp" />

    <!-- 그룹5: 하단 3레이블 -->
    <TextView
        android:id="@+id/widget_large_period"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="사용 기간 : --"
        android:textColor="@color/widget_text_muted"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="600"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_large_expiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="다음 소멸 : --"
        android:textColor="@color/widget_text_muted"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="600"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/widget_large_next_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="다음 연차 : --"
        android:textColor="@color/widget_text_muted"
        android:textSize="16sp"
        android:fontFamily="@font/pretendard_variable"
        android:textFontWeight="600"
        android:includeFontPadding="false" />

</LinearLayout>
